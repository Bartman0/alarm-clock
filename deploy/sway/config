# Sway kiosk config for the alarm clock.
#
# Rotates the official Touch Display 2 (720x1280 native) to landscape 1280x720
# and launches the app fullscreen with no decorations. Rotating here — in the
# compositor — keeps pointer/touch input aligned with the display (rotating via
# the kernel's video= line does not).

output DSI-2 transform 90

default_border none
default_floating_border none

# The app is a native Wayland client; no Xwayland needed.
xwayland disable

# Dim the backlight to 50% after 2 minutes of no touch; restore on any touch.
# (Only the backlight is dimmed — the output stays on so the clock keeps
# updating and alarms are unaffected.)
exec swayidle -w timeout 120 '/etc/alarmclock/backlight.sh 10' resume '/etc/alarmclock/backlight.sh 50'

exec /usr/local/bin/alarmclock
