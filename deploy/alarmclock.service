[Unit]
Description=Alarm Clock (kiosk)
After=systemd-user-sessions.service network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
# install.sh rewrites User= and XDG_RUNTIME_DIR to the installing user.
User=pi
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
Environment=XDG_RUNTIME_DIR=/run/user/1000
# cage is a minimal single-application Wayland compositor: it runs only the
# alarm clock, fullscreen, with no desktop.
ExecStart=/usr/bin/cage -- /usr/local/bin/alarmclock
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
