[Unit]
Description=Alarm Clock (kiosk)
After=systemd-user-sessions.service network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
# install.sh rewrites User= and XDG_RUNTIME_DIR to the installing user.
User=pi
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
Environment=XDG_RUNTIME_DIR=/run/user/1000
# sway runs as the kiosk compositor: it rotates the display to landscape and
# launches only the alarm clock, fullscreen (see /etc/alarmclock/sway.config).
ExecStart=/usr/bin/sway -c /etc/alarmclock/sway.config
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
